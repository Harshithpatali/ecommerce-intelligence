.streamlit/secrets.toml

# ------------------------------------------------------------
# Frontend temporary/build files
# ------------------------------------------------------------
frontend/node_modules/
frontend/.vite/
frontend/dist/
frontend/.env
# ------------------------------------------------------------
# OS files
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
"@ | Set-Content .gitignore
# Agent / local AI tooling
.agents/
